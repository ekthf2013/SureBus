{
  "rewrites": [
    {
      "source": "/api/subway/:path*",
      "destination": "http://swopenAPI.seoul.go.kr/api/subway/:path*"
    },
    {
      "source": "/api/public-bus/:path*",
      "destination": "http://apis.data.go.kr/:path*"
    },
    {
      "source": "/api/odsay/:path*",
      "destination": "https://api.odsay.com/:path*"
    },
    {
      "source": "/api/kakao-traffic/:path*",
      "destination": "https://dapi.kakao.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
